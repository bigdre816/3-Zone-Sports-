# Copy to .env and adjust. In production (TZ_ENV=production) the demo secrets and
# short/duplicate keys are refused at startup.

# demo | local | staging | production
TZ_ENV=demo

# Bind hosts and ports (run.py --http-port/--ws-port/--host override these).
TZ_HTTP_HOST=127.0.0.1
TZ_HTTP_PORT=8000
TZ_WS_HOST=127.0.0.1
TZ_WS_PORT=8765

# Comma-separated exact origins allowed for CORS and WebSocket handshakes.
TZ_ALLOWED_ORIGINS=http://127.0.0.1:8000

# SQLite database path (created on first run). In production on Render, prefer
# TZ_DATABASE_URL with the service's PostgreSQL connection string.
TZ_DATABASE_PATH=data/three_zone.sqlite3
TZ_DATABASE_URL=
TZ_DATA_DIR=data

# Secrets. MUST be set to unique, >=32 character values in production, and the
# two keys MUST differ.
TZ_TOKEN_SECRET=three-zone-demo-token-secret-CHANGE-ME-0000000000
TZ_MEDIA_SERVICE_KEY=three-zone-demo-media-service-key-CHANGE-ME-000000

# Token lifetimes (seconds) and feed timeout.
TZ_SESSION_TTL=3600
# Playback lease TTL (seconds). Must be 60 or less. TZ_LEASE_TTL is an alias.
TZ_PLAYBACK_LEASE_SECONDS=60
TZ_LEASE_TTL=60
TZ_INGEST_TTL=21600
TZ_HEARTBEAT_TIMEOUT=12

# Hosted live rail. Default demo keeps local MP4 + encoder heartbeats.
# cloudflare is the first real hosted rail (Mux is a later empty seam).
TZ_LIVE_MEDIA_PROVIDER=demo
# Legacy alias: demo|cloudflare applies to the live rail; fake applies to UGC only.
TZ_MEDIA_PROVIDER=demo
TZ_PUBLIC_BASE_URL=http://127.0.0.1:8000
TZ_CLOUDFLARE_ACCOUNT_ID=
TZ_CLOUDFLARE_API_TOKEN=
# Cursor Cloud environment secret named CLOUDFLARE is also accepted as the API token
# (or as a JSON object with account_id, api_token, customer_code, webhook_secret).
TZ_CLOUDFLARE_CUSTOMER_CODE=
TZ_CLOUDFLARE_WEBHOOK_SECRET=
TZ_CLOUDFLARE_ALLOWED_ORIGINS=http://127.0.0.1:8000
TZ_CLOUDFLARE_DELETE_RECORDING_AFTER_DAYS=365
TZ_CLOUDFLARE_PREFER_LOW_LATENCY=false

# Viewer measurement (authenticated member/session, not operator-only).
TZ_VIEWER_HEARTBEAT_INTERVAL_SECONDS=15
TZ_VIEWER_STALE_AFTER_SECONDS=90

# Seeded local sign-in passwords (refused in production if still these values).
TZ_SEED_PASSWORD_VIEWER=change-me-viewer-local
TZ_SEED_PASSWORD_WORKER=change-me-worker-local
TZ_SEED_PASSWORD_OWNER=change-me-owner-local

# Member network (UGC) media provider. "fake" is the CI/local default.
# Cloudflare Stream is opt-in for TUS full games and basic POST clips.
TZ_UGC_MEDIA_PROVIDER=fake
TZ_FAKE_WEBHOOK_SECRET=fake-webhook-secret

# Photos never go to Stream. "fake" issues a PUT URL to object storage.
# Set TZ_PHOTO_STORAGE=s3 for R2/MinIO/AWS with presigned PUT.
TZ_PHOTO_STORAGE=fake
TZ_PHOTO_S3_ENDPOINT=
TZ_PHOTO_S3_BUCKET=
TZ_PHOTO_S3_ACCESS_KEY=
TZ_PHOTO_S3_SECRET_KEY=
TZ_PHOTO_S3_REGION=auto
TZ_PHOTO_WEBHOOK_SECRET=
TZ_MAX_POST_VIDEO_SECONDS=90
TZ_MAX_GAME_CLIP_SECONDS=90
TZ_MAX_GAME_BYTES=8589934592
TZ_MAX_PHOTO_BYTES=8388608
TZ_PUBLIC_APP_URL=http://127.0.0.1:8000

# Optional async evidence handoff to Moten. Three-Zone keeps running if Moten is
# unavailable; handoff jobs are queued locally and can be retried.
TZ_MOTEN_SERVICE_URL=
TZ_MOTEN_SHARED_SECRET=
TZ_MOTEN_TIMEOUT_SECONDS=5

# XRPL settlement publication. Never put video, PII, heartbeats, or keys on ledger.
# Demo receipts are labeled DEMO- and simulated=1. Never commit a real signing secret.
TZ_XRPL_MODE=demo
TZ_XRPL_RPC_URL=
TZ_XRPL_ACCOUNT=
TZ_XRPL_SIGNING_SECRET=
TZ_XRPL_PUBLICATION_MODE=batch
TZ_XRPL_BATCH_MAX_RECORDS=500
TZ_XRPL_BATCH_MAX_AGE_SECONDS=3600
XRPL_RPC_URL=
XRPL_NETWORK=
XRPL_AUDIT_ACCOUNT=
XRPL_SIGNING_SECRET=
XRPL_KEY_ID=

# THREEZONE AI Gateway — paste into config.example.env / Render env
# Default OFF so production boots without providers or keys.

# Process kill switch — must be explicitly true to allow gateway.run()
# Default when unset: false (fail-closed). Settings/YAML cannot bypass this.
THREEZONE_AI_ENABLED=false

# Optional overlay YAML (defaults live in threezone_ai/config.default.yaml)
# THREEZONE_AI_CONFIG=/path/to/gateway.overlay.yaml

# Lineage (durable volume recommended on Render)
THREEZONE_AI_LINEAGE_PATH=data/lineage.jsonl
THREEZONE_AI_LINEAGE_BACKEND=jsonl

# Local-first (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5-coder:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
LOCAL_WHISPER_MODEL=base

# Timeouts
THREEZONE_AI_HTTP_TIMEOUT=60
THREEZONE_AI_OLLAMA_TIMEOUT=30

# Optional overflow / fallback keys (never required at import time)
# GROQ_API_KEY=
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# GROQ_WHISPER_MODEL=whisper-large-v3
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct

