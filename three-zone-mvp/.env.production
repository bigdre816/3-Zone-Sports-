# Three-Zone Sports Production Configuration
# DO NOT commit real secrets. Use Render environment variables instead.

# Environment
TZ_ENV=production

# Server Configuration
TZ_HTTP_HOST=0.0.0.0
TZ_HTTP_PORT=8000
TZ_WS_HOST=0.0.0.0
TZ_WS_PORT=8765

# Database
TZ_DATABASE_PATH=/var/data/three_zone.sqlite3

# Security (set via Render secrets, not here)
# TZ_TOKEN_SECRET=<set-in-render>
# TZ_MEDIA_SERVICE_KEY=<set-in-render>

# Origins
TZ_ALLOWED_ORIGINS=https://3zonesports.com,https://www.3zonesports.com

# Media Providers
TZ_LIVE_MEDIA_PROVIDER=demo
TZ_UGC_MEDIA_PROVIDER=fake

# Media
TZ_SESSION_TTL=3600
TZ_LEASE_TTL=60
TZ_INGEST_TTL=21600
